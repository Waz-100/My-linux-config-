{
    "layer": "top",
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "modules-left": [
        "custom/visualizer",
	"mpris",
        "hyprland/window"
    ],
    "modules-center": [
        "hyprland/workspaces"
        
    ],
    "modules-right": [
        "pulseaudio",
        "battery",
        "group/hardware",
        "custom/exit",
        "network",
        "clock"
    ],


    "hyprland/window": {
        "format": "{}",
        "max-length": 50,
        "separate-outputs": true,
        // trim the app name off the end of titles
        "rewrite": {
            "(.*) — Mozilla Firefox": "$1",
            "(.*) - Code - OSS": "$1",
            "(.*) - Brave": "$1"
        }
    },
    
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "format-charging":" {capacity}%",
        "format-plugged":" {capacity}%"
    },
    "custom/visualizer": {
        "exec": "~/.config/waybar/Script/visualizer.sh",
        "tooltip": false,
        "on-click":"~/.config/rofi/launchers/type-6/launcher.sh"
    },

    // now playing pill (optional): add "mpris" to "modules-left" above to turn it on
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "dynamic-order": ["title", "artist"],
        "dynamic-len": 30,
        "player-icons": {
            "default": "▶",
            "spotify": "󰓇"
        },
        "tooltip-format": "{player}: {title} - {artist}",
        "on-click": "playerctl play-pause"
    },

    "clock": {
        "format-alt": "{:%a, %d. %b  %H:%M}",
        "tooltip-format":"<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "pulseaudio/slider#out": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal",
        "zero-on-mute": false,
        "unmute-on-volume-change": false
    },
    "pulseaudio/slider#in": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal",
        "target": "source"
    },
    "pulseaudio": {
        "format": "㊋ {volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "alsa_output.pci-0000_00_1f.3.analog-stereo": "󰓃",
            "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
            "headphone": "",
            "hands-free": "󰂑",
            "headset": "󰂑",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                ""
            ]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol"
    },
    "network": {
        "interface": "wlp0s20f3",
        "format": "{ifname}",
        "format-wifi": "  {ipaddr} ({signalStrength}%)",
        "format-ethernet": "{ifname} ",
        "format-disconnected": "", //An empty format will hide the module.
        "tooltip-format": "{ifname}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50
    },
    "hyprland/workspaces": {
        // every workspace is a dot; once it has windows it shows their app icons
        "format": "{windows}",
        "format-window-separator": " ",
        "window-rewrite-default": "󰣆",
        // show at most 4 app icons per workspace (newer Waybar only, older versions ignore it)
        "max-windows": 4,
        // rules are case-insensitive; class<...> must match the app's whole window class
        // find a class with: hyprctl clients | grep class
        "window-rewrite": {
            "class<(kitty|foot|alacritty|ghostty|wezterm)>": "󰆍",
            "class<firefox.*>": "󰈹",
            "class<spotify>": "󰓇",
            "class<(code-oss|code|vscodium)>": "󰨞",
            "class<(brave-browser|chromium|google-chrome)>": "󰖟",
            "class<(thunar|org.gnome.nautilus|org.kde.dolphin|pcmanfm|nemo)>": "󰉋",
            "class<(discord|vesktop|webcord)>": "󰙯",
            "class<steam>": "󰓓",
            "class<vlc>": "󰕼",
            "class<mpv>": "󰎁",
            "class<obsidian>": "󰎞"
        },
        "persistent-workspaces": {
            "*": 6, // 5 workspaces by default on every monitor
            "HDMI-A-1": 3 // but only three on HDMI-A-1
        }
    },
    //uh this for that quicklink

    //hardware short ball knowledge
    "group/hardware": {
        "orientation":"horizontal",
        "modules":[
        "disk",
        "cpu",
        "memory"
        ]

    },

    "cpu":{
        "format":"/  {usage}%"
    },

    "disk":{
        "format": "󰆧 {percentage_used}%",
        "interval": 60,
        "path": "/"
    },

    "memory":{
        "format": "/ 󰍛 {}%"
    },


    "custom/exit": {
        "format":"😴🥱",
        "on-click":"wlogout",
        "tooltip":false

    }

}
